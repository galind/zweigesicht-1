{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd explorer && npm ci",
  "buildCommand": "cd explorer && npm run build:vercel && cd .. && rm -rf .vercel/output && mkdir -p .vercel/output && cp -R explorer/.vercel/output/. .vercel/output/",
  "git": {
    "deploymentEnabled": {
      "codex/codebase-cleanup-2026-10-31": false,
      "codex/escapement-clearance-study": false,
      "codex/bench-entry-flow": false,
      "codex/workshop-environment": false,
      "codex/public-documentation-review": false,
      "codex/publication-blockers": false,
      "codex/public-repo-hardening": false,
      "codex/repository-cleanup-2026-10-23": false,
      "codex/staging-code-cleanup": false
    }
  }
}
