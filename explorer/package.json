{
  "name": "zweigesicht-explorer",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build && node scripts/prune-build-output.mjs",
    "build:vercel": "NITRO_PRESET=vercel vite build && node scripts/prune-build-output.mjs .vercel/output/static",
    "start": "vinext start",
    "lint": "oxlint",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit",
    "test": "node --test ../tests/*.test.mjs",
    "test:runtime": "node ../scripts/cad/review-runtime.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@vercel/analytics": "^2.0.1",
    "clsx": "2.1.1",
    "lucide-react": "1.31.0",
    "nitro": "^3.0.260903-beta",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-server-dom-webpack": "^19.2.8",
    "tailwind-merge": "3.6.0",
    "three": "^0.186.0",
    "tw-animate-css": "1.4.0",
    "vinext": "^1.0.0-beta.9"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.183.1",
    "@vitejs/plugin-rsc": "^0.5.34",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "^8.2.2"
  },
  "type": "module",
  "overrides": {
    "sharp": "0.35.4"
  }
}
